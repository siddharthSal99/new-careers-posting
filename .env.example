# Postgres connection string (Neon: use the pooled connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Password for the web UI
APP_PASSWORD=change-me

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" when it calls the cron route
CRON_SECRET=some-long-random-string

# Email via Resend (without it, the digest is printed to the logs instead)
RESEND_API_KEY=
# With Resend's shared sender you can only email the address you signed up with.
RESEND_FROM=Job Tracker <onboarding@resend.dev>

# Optional: AI resume matching with Claude Haiku. Without it, jobs are filtered but not scored.
ANTHROPIC_API_KEY=

# Optional: public URL of the app, used for links in the email
APP_URL=https://your-app.vercel.app

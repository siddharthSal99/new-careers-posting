# Postgres connection string (Neon: use the pooled connection string)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# 32 random bytes, base64. Encrypts users' Anthropic API keys in the database.
# Generate with: openssl rand -base64 32
# Don't change it later: saved keys can't be decrypted with a different one (users would re-enter them).
ENCRYPTION_KEY=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" when it calls the cron route
CRON_SECRET=some-long-random-string

# Optional: require this invite code to sign up. Leave unset for open sign-up.
SIGNUP_CODE=

# Email via Resend (without it, digests are printed to the logs instead)
RESEND_API_KEY=
# The shared sender (onboarding@resend.dev) can only email the address you signed up to Resend with.
# To email other users, verify a domain in Resend and use an address on it here.
RESEND_FROM=Job Tracker <onboarding@resend.dev>

# Optional: public URL of the app, used for links in the email
APP_URL=https://your-app.vercel.app
